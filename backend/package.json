{
  "name": "pool-tables-backend",
  "version": "0.1.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "nodemailer": "^10.6.0",
    "openid-client": "^6.9.1",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "stripe": "^23.2.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.22.1",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^openid-client$": "<rootDir>/tests/__mocks__/openid-client.js"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
