    "openid-client": "^5.2.0"
    ,"bcryptjs": "^2.4.3",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "prisma": "^5.3.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "cross-env": "^7.0.3"
  }
  ,
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "roots": ["<rootDir>/tests"]
