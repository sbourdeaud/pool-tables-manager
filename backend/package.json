{
  "name": "pool-tables-backend",
  "version": "0.1.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.8",
    "prisma": "^7.10.1",
    "stripe": "^23.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^openid-client$": "<rootDir>/tests/__mocks__/openid-client.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
