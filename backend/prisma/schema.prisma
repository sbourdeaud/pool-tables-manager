generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String?
  email            String   @unique
  role             String   @default("user")
  preferredLanguage String? @map("preferred_language")
  preferredTheme   String? @map("preferred_theme")
  createdAt        DateTime @default(now()) @map("created_at")
}

model TableType {
  id                String  @id @default(uuid())
  name_en           String
  name_fr           String?
  base_hourly_cents Int
  vatRatePercent    Int      @default(20) @map("vat_rate_percent")
  createdAt         DateTime @default(now()) @map("created_at")
}

model PoolTable {
  id          String   @id @default(uuid())
  tableTypeId String  @map("table_type_id")
  number      Int      @unique
  status      String   @default("available")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tableTypeId])
}

model Drink {
  id             String @id @default(uuid())
  name_en        String
  name_fr        String?
  price_cents    Int
  taxable        Boolean @default(true)
  vatRatePercent Int     @default(20) @map("vat_rate_percent")
  createdAt      DateTime @default(now()) @map("created_at")
}

model Session {
  id            String   @id @default(uuid())
  tableId       String   @map("table_id")
  patronId      String?  @map("patron_id")
  startedAt     DateTime @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  numberOfPlayers Int?   @map("number_of_players")
  pin           String?
}

model TabLineItem {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  type             String
  description      String?
  quantity         Float    @default(1)
  unitPrice        Int      @map("unit_price")
  totalCents       Int      @map("total_cents")
  vatRatePercent   Int?     @map("vat_rate_percent")
  vatAmountCents   Int?     @default(0) @map("vat_amount_cents")
  createdAt        DateTime @default(now()) @map("created_at")
  voidedAt         DateTime? @map("voided_at")
  voidedBy         String?  @map("voided_by")
  voidReason       String?  @map("void_reason")
  correctedFromId  String?  @map("corrected_from_id")

  @@index([sessionId])
  @@index([voidedAt])
}

model Transaction {
  id         String @id @default(uuid())
  userId     String? @map("user_id")
  sessionId  String? @map("session_id")
  amountCents Int    @map("amount_cents")
  type       String
  createdAt  DateTime @default(now()) @map("created_at")
}

model Subscription {
  id                String   @id @default(uuid())
  patronId          String @map("patron_id")
  plan_name         String
  monthly_fee_cents Int
  active_from       DateTime
  active_until      DateTime?
  auto_renew        Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// Sequentially numbered receipt issued when a table session is paid out (checkout).
// Required for French anti-fraud compliance (CGI art. 286-I-3 bis / ISCA principles):
// once created a receipt is never modified or deleted.
model Receipt {
  id               String   @id @default(uuid())
  number           Int
  year             Int
  sessionId        String   @map("session_id")
  itemsJson        String   @map("items_json")
  subtotalHtCents  Int      @map("subtotal_ht_cents")
  vatCents         Int      @map("vat_cents")
  totalTtcCents    Int      @map("total_ttc_cents")
  discountCents    Int      @default(0) @map("discount_cents")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([year, number])
  @@index([sessionId])
}

// A locked accounting period (day/month/year). Once closed, the totals snapshot is
// immutable and sales within the period can no longer be voided or corrected.
model ClosurePeriod {
  id           String   @id @default(uuid())
  periodType   String   @map("period_type")
  periodKey    String   @map("period_key")
  fromDate     DateTime @map("from_date")
  toDate       DateTime @map("to_date")
  totalsJson   String   @map("totals_json")
  totalHtCents Int      @map("total_ht_cents")
  totalVatCents Int     @map("total_vat_cents")
  totalTtcCents Int     @map("total_ttc_cents")
  closedAt     DateTime @default(now()) @map("closed_at")
  closedBy     String?  @map("closed_by")

  @@unique([periodType, periodKey])
}

model PendingOrder {
  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  tableId     String    @map("table_id")
  itemsJson   String    @map("items_json")
  totalCents  Int       @map("total_cents")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  fulfilledAt DateTime? @map("fulfilled_at")

  @@index([sessionId])
  @@index([status])
}
